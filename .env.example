# Ally — configuration du serveur.
#
# Copiez ce fichier en « .env » et renseignez-le, ou posez ces variables
# directement dans l'environnement de votre hébergeur. Rien n'est lu depuis un
# fichier par le serveur lui-même : c'est l'hébergeur ou votre shell qui les
# fournit. Avec Docker : « docker run --env-file .env ».
#
# Ne versionnez jamais le fichier rempli — .gitignore l'écarte déjà.


# ─────────────────────────────────────────────── Obligatoire en production ──

# La clé qui chiffre le contenu en base (résumés d'appel, corps d'email,
# configuration du cabinet) et signe les jetons. 32 octets en hexadécimal.
#
#   npm run cle
#
# La perdre, c'est perdre toutes les données chiffrées : aucune récupération
# n'est possible. La changer invalide tout ce qui a déjà été écrit.
ALLY_SECRET_KEY=

# Bascule la sécurité en mode production : cookie Secure, codes jamais
# renvoyés dans les réponses HTTP, messages d'erreur internes masqués.
NODE_ENV=production

# Port d'écoute. La plupart des hébergeurs le fournissent eux-mêmes.
PORT=8787

# Derrière un reverse proxy (Nginx, Caddy, Fly, Railway…), l'adresse du
# visiteur arrive dans X-Forwarded-For. Sans ce drapeau, la limitation de
# tentatives compterait toutes les connexions comme venant du proxy — donc
# bloquerait tout le monde d'un coup. Ne l'activez QUE derrière un proxy de
# confiance : sinon n'importe qui peut se déclarer une autre adresse.
ALLY_TRUST_PROXY=1

# Où le serveur écrit son fichier de données. Sur un hébergeur, pointez-le
# vers un volume persistant — sans quoi tout disparaît au redéploiement.
ALLY_DATA_DIR=/var/lib/ally


# ─────────────────────────────────────────────────── La console plateforme ──

# Le compte qui voit tous les cabinets et peut les suspendre, les rouvrir, les
# supprimer. Il ne se crée pas par l'inscription : aucune route ne doit pouvoir
# accorder ce rôle. Il vient d'ici, c'est-à-dire de quelqu'un qui a déjà accès
# à la machine.
#
# Douze caractères sont un plancher, pas une recommandation.
ALLY_ADMIN_EMAIL=
ALLY_ADMIN_PASSWORD=


# ──────────────────────────────────────────────────────────── Le courrier ──

# Comment les codes à six chiffres atteignent les gens.
#
#   email  (défaut) — une adresse se confirme par un code reçu par email.
#   open            — pas de confirmation : le compte est actif dès
#                     l'inscription. Choix de lancement assumé, à poser ici et
#                     nulle part ailleurs.
#
# En production, « email » sans fournisseur configuré ci-dessous empêche le
# serveur de démarrer : les comptes créés ne pourraient jamais être confirmés.
ALLY_VERIFY_MODE=email

# L'expéditeur. Il doit être vérifié chez votre fournisseur, sinon les envois
# sont refusés.
ALLY_MAIL_FROM=bonjour@votre-domaine.fr
ALLY_MAIL_FROM_NAME=Ally

# Un fournisseur, au choix. Brevo si vous avez une clé d'API ;
# sinon n'importe quel relais SMTP.
BREVO_API_KEY=
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.votre-hebergeur.fr:465


# ──────────────────────────────────────────────────────── L'agent vocal ──

# Secret partagé avec Retell, qui signe les webhooks d'appel. Sans lui, le
# serveur refuse tout appel entrant : non signé, n'importe qui injecterait de
# faux appels dans le dossier d'un cabinet.
RETELL_WEBHOOK_SECRET=
