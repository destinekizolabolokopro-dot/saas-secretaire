# Données du serveur : jamais dans Git. Elles contiennent des comptes, des
# empreintes de mots de passe et des contenus chiffrés — rien de tout cela
# n'a sa place dans un dépôt.
server/data/
*.tmp

# La configuration du serveur : clé de chiffrement, mot de passe de
# l'administrateur, clés d'API. Le modèle .env.example, lui, est versionné.
.env
.env.*
!.env.example
node_modules/
